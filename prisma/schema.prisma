generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subject {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  description  String?
  sortOrder    Int
  createdAt    DateTime      @default(now())
  customTopics CustomTopic[]
  questions    Question[]
  topics       Topic[]
}

model Topic {
  id              String           @id @default(cuid())
  subjectId       String
  name            String
  slug            String
  syllabusSection String?
  createdAt       DateTime         @default(now())
  legalReferences LegalReference[]
  questions       Question[]
  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Question {
  id                   String           @id @default(cuid())
  subjectId            String
  topicId              String
  title                String
  factsIssue           String
  difficulty           String           @default("MEDIUM")
  questionSource       String           @default("VERIFIED_BAR_QUESTION")
  barYearReference     String?
  legalSource          String?
  legalProvision       String?
  relatedJurisprudence String?
  verificationStatus   String           @default("VERIFIED")
  dateVerified         DateTime?
  verifiedBy           String?
  bestAnswerA          String?
  bestAnswerL          String?
  bestAnswerA2         String?
  bestAnswerC          String?
  howToAnswer          String?
  userMaterialId       String?
  customTopicId        String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  legalReferences      LegalReference[]
  customTopic          CustomTopic?     @relation(fields: [customTopicId], references: [id])
  subject              Subject          @relation(fields: [subjectId], references: [id])
  topic                Topic            @relation(fields: [topicId], references: [id])
  userMaterial         UserMaterial?    @relation(fields: [userMaterialId], references: [id])
  submissions          Submission[]
}

model LegalReference {
  id                 String    @id @default(cuid())
  questionId         String?
  topicId            String?
  authorityType      String
  citation           String
  officialTitle      String
  keyProvisionsText  String?
  doctrineSummary    String
  verificationStatus String    @default("VERIFIED")
  dateVerified       DateTime?
  createdAt          DateTime  @default(now())
  question           Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topic              Topic?    @relation(fields: [topicId], references: [id])
}

model Submission {
  id           String      @id @default(cuid())
  questionId   String
  answerA      String
  legalBasisL  String
  applicationA String
  conclusionC  String
  timeSpentSec Int         @default(0)
  createdAt    DateTime    @default(now())
  evaluation   Evaluation?
  question     Question    @relation(fields: [questionId], references: [id])
}

model Evaluation {
  id                  String     @id @default(cuid())
  submissionId        String     @unique
  overallScore        Float
  scoreA              Float
  scoreL              Float
  scoreA2             Float
  scoreC              Float
  whatWentWell        String
  whatWasMissed       String
  legalErrors         String
  legalReasoningNotes String
  howToImprove        String
  evaluatorMode       String
  verifiedRefsUsed    String
  createdAt           DateTime   @default(now())
  submission          Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model UserMaterial {
  id           String     @id @default(cuid())
  title        String
  materialType String
  subjectSlug  String
  content      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  questions    Question[]
}

model CustomTopic {
  id            String            @id @default(cuid())
  subjectId     String
  title         String
  description   String?
  rawPastedText String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  subject       Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  cases         CustomTopicCase[]
  questions     Question[]
}

model CustomTopicCase {
  id                 String      @id @default(cuid())
  customTopicId      String
  caseTitle          String
  caseCitation       String
  notes              String?
  verificationStatus String      @default("USER_PROVIDED_NEEDS_REVIEW")
  sortOrder          Int         @default(0)
  createdAt          DateTime    @default(now())
  customTopic        CustomTopic @relation(fields: [customTopicId], references: [id], onDelete: Cascade)
}
